server:
  port: "8080"
  mode: "debug"  # debug, release

database:
  host: "localhost"
  port: 3306
  user: "root"
  password: "your_database_password"
  dbname: "ino"

redis:
  host: "localhost"
  port: 6379
  password: ""
  db: 0

milvus:
  host: "localhost"
  port: 19530

neo4j:
  uri: "bolt://localhost:7687"
  username: "neo4j"
  password: "your_neo4j_password"

indexer:
  embedding:
    base_url: "https://your-embedding-service.com/api/v3"
    api_key: "your_embedding_api_key"
    model: "your_embedding_model"
  extractor:
    base_url: "https://your-extraction-service.com/api/v3"
    api_key: "your_extraction_api_key"
    model: "your_extraction_model"
  # embedding:
  #   base_url: "https://api.siliconflow.cn/v1/embeddings"
  #   api_key: "your_siliconflow_api_key"
  #   model: "BAAI/bge-m3"
  # extractor:
  #   base_url: "https://api.siliconflow.cn/v1/chat/completions"
  #   api_key: "your_siliconflow_api_key"
  #   model: "Qwen/Qwen3-8B" # THUDM/GLM-4-9B-0414
  

# 日志配置
logging:
  level: "info"  # debug, info, warn, error
  format: "json"  # json, text
  output: "stdout"  # stdout, file

# 应用配置
app:
  name: "ino Knowledge System"
  version: "v1.0.0"
  debug: true

# 文件上传配置
upload:
  max_size: 104857600  # 100MB
  allowed_types: ["pdf", "txt", "md", "doc", "docx"]
  storage_path: "/app/uploads"

# 缓存配置
cache:
  default_ttl: 1800  # 30分钟
  max_keys: 10000 

# Langfuse 配置
langfuse:
  enabled: true
  host: "http://your-langfuse-host:3000"
  public_key: "your_langfuse_public_key"
  secret_key: "your_langfuse_secret_key"